---
import type { Project } from '../data/engineering';
import { pick, localePath, type Lang } from '../i18n';
interface Props { items: Project[]; lang: Lang }
const { items, lang } = Astro.props;
const href = (h?: string) => (h && h.startsWith('/') ? localePath(h, lang) : h);
---
<div class="grid gap-x-10" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));">
  {items.map((p) => (
    <article class="flex flex-col gap-1.5 border-t border-rule py-4">
      <h3 class="m-0 text-lg font-semibold text-navy">
        {p.href ? <a href={href(p.href)} class="text-navy no-underline hover:underline">{pick(p.title, lang)}</a> : pick(p.title, lang)}
      </h3>
      <p class="m-0 text-base leading-relaxed text-body">{pick(p.text, lang)}</p>
      <p class="m-0 text-sm text-faint">{pick(p.meta, lang)}</p>
    </article>
  ))}
</div>
