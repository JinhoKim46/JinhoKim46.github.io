---
import '../styles/global.css';
import { ui, pick, localePath, basePath, sections, type Lang } from '../i18n';
import { contacts } from '../config';

interface Props { lang: Lang; title?: string; description?: string }
const { lang, title, description } = Astro.props;

const here = basePath(Astro.url.pathname);
const home = localePath('/', lang);
const nav = sections.map((s) => ({ href: `${home}#${s.id}`, label: pick(s.label, lang) }));
const name = pick(ui.name, lang);
const fullTitle = title ? `${title} | ${name}` : name;
const desc = description ?? (lang === 'ko'
  ? 'MRI reconstruction 연구와 ML engineering. 김진호의 포트폴리오.'
  : 'MRI reconstruction research and ML engineering. Portfolio of Jinho Kim.');
const other: Lang = lang === 'en' ? 'ko' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localePath(here, 'en'), Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(localePath(here, 'ko'), Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL('/media/zs_proposed_cor_full.png', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 bg-white px-3 py-2">{pick(ui.skip, lang)}</a>
    <header class="sm:sticky top-0 z-10 border-b border-rule bg-paper/95 backdrop-blur">
      <nav aria-label="Main" class="mx-auto max-w-6xl px-4 sm:px-10 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px]">
        <a href={home} class="mr-auto py-2 text-base font-semibold text-navy no-underline">{name}</a>
        {nav.map((n) => <a href={n.href} class="py-2 text-muted no-underline hover:text-navy">{n.label}</a>)}
        <a
          href={localePath(here, other)}
          hreflang={other}
          lang={other}
          aria-label={pick(ui.language, lang)}
          class="rounded-full border border-rule-strong px-3 py-1.5 text-[13px] text-navy no-underline hover:bg-white"
        >{other === 'ko' ? '한국어' : 'English'}</a>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="bg-navy text-[#c9d3e6]">
      <div class="mx-auto max-w-6xl px-4 sm:px-10 py-10 flex flex-wrap items-baseline gap-x-8 gap-y-3 text-[15px]">
        <span class="mr-auto font-semibold text-white">{name}</span>
        {contacts.map((c) => <a href={c.href} class="text-white hover:text-[#c9d3e6]">{c.label}</a>)}
      </div>
    </footer>
    <script>
      // Links that leave the current view open in a new tab and show a link icon.
      // In-page anchors (#section) and mail links keep their normal behaviour.
      const SVG = 'http://www.w3.org/2000/svg';
      const paths: Record<string, string[]> = {
        external: ['M15 3h6v6', 'M10 14 21 3', 'M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'],
        mail: ['M4 4h16v16H4z', 'm22 6-10 7L2 6'],
        internal: ['M5 12h14', 'm12 5 7 7-7 7'],
      };
      const icon = (kind: keyof typeof paths) => {
        const svg = document.createElementNS(SVG, 'svg');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('width', '0.85em');
        svg.setAttribute('height', '0.85em');
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        svg.setAttribute('stroke-width', '2');
        svg.setAttribute('stroke-linecap', 'round');
        svg.setAttribute('stroke-linejoin', 'round');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('class', 'link-icon');
        svg.style.marginLeft = '0.3em';
        svg.style.verticalAlign = '-0.08em';
        svg.style.display = 'inline-block';
        for (const d of paths[kind]) {
          const path = document.createElementNS(SVG, 'path');
          path.setAttribute('d', d);
          svg.appendChild(path);
        }
        return svg;
      };
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const href = a.getAttribute('href') ?? '';
        const plainHash = href.startsWith('#');
        const mail = href.startsWith('mailto:');
        const external = /^https?:\/\//.test(href);
        if (!plainHash && !mail) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
        // Skip navigation, footer, call-to-action buttons and image links.
        if (plainHash || a.closest('nav, footer') || a.querySelector('img') || a.classList.contains('rounded-md') || a.dataset.noicon !== undefined) return;
        const kind = mail ? 'mail' : external ? 'external' : 'internal';
        a.appendChild(icon(kind));
      });
    </script>
  </body>
</html>
