---
import '../styles/global.css';
import { ui, sections, type Lang } from '../i18n';
import { contacts } from '../config';

interface Props { title: string; titleKo: string; description: string; descriptionKo: string; lang: Lang }
const { title, titleKo, description, descriptionKo, lang } = Astro.props;
// The home page passes the name itself as the title, so do not repeat it.
const fullEn = title === ui.name.en ? ui.name.en : `${title} | ${ui.name.en}`;
const fullKo = titleKo === ui.name.ko ? ui.name.ko : `${titleKo} | ${ui.name.ko}`;
const pageEn = Astro.url.pathname.replace(/^\/ko(?=\/|$)/, '') || '/';
// Build date = deploy date; month precision so minor fixes don't churn it.
const built = new Date();
const updated = {
  en: built.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' }),
  ko: built.toLocaleDateString('ko-KR', { month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' }),
};
---
<!doctype html>
<html lang={lang} data-title-en={fullEn} data-title-ko={fullKo}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{lang === 'ko' ? fullKo : fullEn}</title>
    <meta name="description" content={lang === 'ko' ? descriptionKo : description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(pageEn, Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(pageEn === '/' ? '/ko/' : `/ko${pageEn}`, Astro.site)} />
    <meta property="og:title" content={fullEn} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/media/zs_proposed_cor_full.png', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 bg-white px-3 py-2">
      <span class="l-en">{ui.skip.en}</span><span class="l-ko">{ui.skip.ko}</span>
    </a>
    <header class="sm:sticky top-0 z-10 border-b border-rule bg-paper/95 backdrop-blur">
      <nav aria-label="Main" class="mx-auto max-w-6xl px-4 sm:px-10 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px]">
        <a href="/" class="l-en mr-auto py-2 text-base font-semibold text-navy no-underline">{ui.name.en}</a>
        <a href="/ko/" class="l-ko mr-auto py-2 text-base font-semibold text-navy no-underline">{ui.name.ko}</a>
        {sections.map((s) => (
          <>
            <a href={`#en-${s.id}`} class="l-en py-2 text-muted no-underline hover:text-navy">{s.label.en}</a>
            <a href={`#ko-${s.id}`} class="l-ko py-2 text-muted no-underline hover:text-navy">{s.label.ko}</a>
          </>
        ))}
        <button
          type="button"
          data-switch
          class="rounded-full border border-rule-strong px-3 py-1.5 text-[13px] text-navy hover:bg-white"
          aria-label={lang === 'ko' ? 'Switch to English' : '한국어로 보기'}
        >{lang === 'ko' ? 'English' : '한국어'}</button>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="bg-navy text-[#c9d3e6]">
      <div class="mx-auto max-w-6xl px-4 sm:px-10 py-10 flex flex-wrap items-baseline gap-x-8 gap-y-3 text-[15px]">
        <span class="l-en mr-auto font-semibold text-white">{ui.name.en}</span>
        <span class="l-ko mr-auto font-semibold text-white">{ui.name.ko}</span>
        {contacts.map((c) => <a href={c.href} class="text-white hover:text-[#c9d3e6]" data-newtab={c.href.startsWith('mailto:') ? undefined : true}>{c.label}</a>)}
        <span class="l-en w-full text-sm">Last updated: {updated.en}</span>
        <span class="l-ko w-full text-sm">최종 업데이트: {updated.ko}</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const SVG = 'http://www.w3.org/2000/svg';

      // In-page language switch: both languages are in the page, so only the language flag changes.
      const syncTitle = () => {
        document.title = (root.lang === 'ko' ? root.dataset.titleKo : root.dataset.titleEn) ?? document.title;
      };
      const switchBtn = document.querySelector<HTMLButtonElement>('[data-switch]');
      switchBtn?.addEventListener('click', () => {
        const next = root.lang === 'ko' ? 'en' : 'ko';
        root.lang = next;
        syncTitle();
        switchBtn.textContent = next === 'ko' ? 'English' : '한국어';
        switchBtn.setAttribute('aria-label', next === 'ko' ? 'Switch to English' : '한국어로 보기');
        const path = location.pathname.replace(/^\/ko(?=\/|$)/, '') || '/';
        history.replaceState(null, '', (next === 'ko' ? '/ko' : '') + path);
      });

      // Link icons: a box with an arrow for links that open a new tab, a plain arrow for the rest.
      const paths: Record<string, string[]> = {
        external: ['M15 3h6v6', 'M10 14 21 3', 'M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'],
        mail: ['M4 4h16v16H4z', 'm22 6-10 7L2 6'],
        internal: ['M5 12h14', 'm12 5 7 7-7 7'],
      };
      const icon = (kind: keyof typeof paths) => {
        const svg = document.createElementNS(SVG, 'svg');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('width', '0.85em');
        svg.setAttribute('height', '0.85em');
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        svg.setAttribute('stroke-width', '2');
        svg.setAttribute('stroke-linecap', 'round');
        svg.setAttribute('stroke-linejoin', 'round');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('class', 'link-icon');
        svg.style.marginLeft = '0.3em';
        svg.style.verticalAlign = '-0.08em';
        svg.style.display = 'inline-block';
        for (const d of paths[kind]) {
          const path = document.createElementNS(SVG, 'path');
          path.setAttribute('d', d);
          svg.appendChild(path);
        }
        return svg;
      };
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const href = a.getAttribute('href') ?? '';
        const plainHash = href.startsWith('#');
        const mail = href.startsWith('mailto:');
        const external = /^https?:\/\//.test(href);
        // Only case-study pages and engineering repository links open in a new tab.
        const newTab = !plainHash && !mail && (href.includes('/research/') || a.dataset.newtab !== undefined);
        if (newTab) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
        if (plainHash || a.closest('nav') || a.querySelector('img') || a.classList.contains('rounded-md') || a.dataset.noicon !== undefined) return;
        a.appendChild(icon(mail ? 'mail' : newTab ? 'external' : 'internal'));
      });
    </script>
  </body>
</html>
