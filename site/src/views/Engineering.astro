---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectList from '../components/ProjectList.astro';
import { ui, pick, type Lang } from '../i18n';
import { groups } from '../data/engineering';

interface Props { lang: Lang }
const { lang } = Astro.props;
const intro = {
  en: 'Most of this started as tooling for my own research and grew from there. Some of it is open source; client and employer work is described without internal details.',
  ko: '대부분 제 연구에 쓰려고 만든 도구에서 시작했습니다. 일부는 오픈소스로 공개했고, 회사나 고객 업무는 내부 정보 없이 범위만 적었습니다.',
};
---
<Base lang={lang} title={pick(ui.navEngineering, lang)}>
  <section class="mx-auto max-w-6xl px-4 sm:px-10 pt-14 pb-20">
    <SectionTitle as="h1">{pick(ui.navEngineering, lang)}</SectionTitle>
    <p class="mt-4 mb-0 max-w-[40em] text-lg leading-[1.75] text-body">{pick(intro, lang)}</p>
    <div class="mt-10 flex flex-col gap-12">
      {groups.map((g) => (
        <section>
          <h2 class="mb-2 mt-0 font-serif text-2xl font-medium text-navy">{pick(g.title, lang)}</h2>
          <ProjectList items={g.items} lang={lang} />
        </section>
      ))}
    </div>
  </section>
</Base>
