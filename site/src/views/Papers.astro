---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PaperList from '../components/PaperList.astro';
import { ui, pick, type Lang } from '../i18n';
import { paperGroups } from '../data/papers';
import { contacts } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const scholar = contacts.find((c) => c.label === 'Google Scholar')!;
const orcid = contacts.find((c) => c.label === 'ORCID')!;
---
<Base lang={lang} title={pick(ui.navPapers, lang)}>
  <section class="mx-auto max-w-5xl px-4 sm:px-10 pt-14 pb-20">
    <SectionTitle as="h1">{pick(ui.navPapers, lang)}</SectionTitle>
    <p class="mt-4 mb-0 flex flex-wrap gap-x-6 text-[15px]"><a href={scholar.href}>Google Scholar</a><a href={orcid.href}>ORCID {orcid.text}</a></p>
    {paperGroups.map((g) => (
      <section class="mt-10">
        <h2 class="mb-4 mt-0 text-lg font-semibold text-muted">{pick(g.title, lang)}</h2>
        <PaperList items={g.items} />
      </section>
    ))}
    <p class="mt-8 mb-0 text-sm text-faint">{pick(ui.coFirst, lang)}</p>
  </section>
</Base>
