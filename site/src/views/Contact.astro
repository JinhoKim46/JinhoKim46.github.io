---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { ui, pick, type Lang } from '../i18n';
import { profile } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} title={pick(ui.navContact, lang)}>
  <section class="mx-auto max-w-5xl px-4 sm:px-10 pt-14 pb-24">
    <SectionTitle as="h1" class="mb-4">{pick(ui.navContact, lang)}</SectionTitle>
    <p class="mt-0 mb-8 max-w-[38em] text-lg leading-relaxed text-body">{pick(profile.status, lang)}</p>
    <ContactBlock lang={lang} heading={false} />
  </section>
</Base>
