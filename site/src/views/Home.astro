---
import Base from '../layouts/Base.astro';
import Compare from '../components/Compare.astro';
import PaperList from '../components/PaperList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { ui, pick, localePath, sections, type Lang } from '../i18n';
import { profile, intro } from '../config';
import { groups } from '../data/engineering';
import { paperGroups } from '../data/papers';
import { bio, timeline, extras } from '../data/about';
import { research } from '../research';

interface Props { lang: Lang }
const { lang } = Astro.props;
const studies = await research(lang);
const label = (id: string) => pick(sections.find((s) => s.id === id)!.label, lang);
const wrap = 'mx-auto max-w-6xl px-4 sm:px-10';
const h2 = 'm-0 font-serif text-[28px] sm:text-[32px] font-medium text-navy';
const ext = (h?: string) => !!h && !h.startsWith('/');
---
<Base lang={lang}>
  <section class={`${wrap} pt-10 sm:pt-14 pb-16 flex flex-wrap gap-12 items-start`}>
    <div class="flex-[1_1_340px] max-w-[440px]">
      <div class="flex items-end gap-5">
        <img src="/media/portrait.jpg" alt={lang === 'ko' ? '김진호 사진' : 'Portrait of Jinho Kim'} width="720" height="960" class="block w-24 sm:w-28 flex-none rounded-sm object-cover" style="aspect-ratio: 3 / 4;" />
        <div>
          <h1 class="m-0 whitespace-nowrap font-serif font-medium text-[40px] sm:text-[50px] leading-[1.05] text-navy">{pick(ui.name, lang)}</h1>
          <p class="mt-2 mb-0 text-xl text-[#8592ab]" lang={lang === 'en' ? 'ko' : 'en'}>{pick(ui.altName, lang)}</p>
        </div>
      </div>
      <p class="mt-7 mb-0 text-lg font-semibold text-navy">{pick(profile.role, lang)}</p>
      <p class="mt-1 mb-0 text-[15px] leading-normal text-muted">{pick(profile.affiliation, lang)}</p>
      <p class="mt-5 mb-0 text-[17px] leading-[1.8] text-body">{pick(intro, lang)}</p>
      <div class="mt-7 flex flex-wrap gap-2.5">
        <a href="#research" class="rounded-md bg-navy px-5 py-3 font-medium text-white no-underline hover:bg-[#1c3566] hover:text-white">{label('research')}</a>
        <a href="#contact" class="rounded-md border border-[#a9b4c8] px-5 py-3 no-underline">{pick(ui.contactMe, lang)}</a>
      </div>
    </div>
    <div class="flex-[1_1_600px] min-w-0">
      <Compare lang={lang} />
    </div>
  </section>

  <div class="bg-white border-t border-rule">
    <section id="research" class={`${wrap} py-16`}>
      <h2 class={h2}>{label('research')}</h2>
      <div class="mt-8 grid gap-x-10 gap-y-8" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));">
        {studies.map((s) => (
          <article class="flex flex-col gap-2.5 border-t-2 border-navy pt-5">
            <p class="m-0 text-sm text-faint">{s.data.venue}, {s.data.year}</p>
            <h3 class="m-0 text-xl font-semibold leading-snug"><a href={localePath(`/research/${s.slug}`, lang)} class="text-navy no-underline hover:underline">{s.data.short}</a></h3>
            <p class="m-0 text-base leading-relaxed text-body">{s.data.card}</p>
            <a href={localePath(`/research/${s.slug}`, lang)} class="mt-auto self-start pt-1 text-[15px]">{pick(ui.caseStudy, lang)}<span class="sr-only">: {s.data.short}</span></a>
          </article>
        ))}
      </div>
    </section>

    <section id="engineering" class={`${wrap} py-16 border-t border-rule`}>
      <h2 class={h2}>{label('engineering')}</h2>
      <div class="mt-8 flex flex-col gap-10">
        {groups.map((g) => (
          <div class="grid gap-x-10 gap-y-3 sm:grid-cols-[200px_1fr]">
            <h3 class="m-0 pt-3 text-[15px] font-semibold text-muted">{g.title}</h3>
            <ul class="m-0 list-none p-0">
              {g.items.map((p) => (
                <li class="grid gap-x-8 gap-y-1 border-t border-rule py-3 md:grid-cols-[220px_1fr]">
                  <div>
                    <span class="font-semibold text-navy">{ext(p.href) ? <a href={p.href} class="text-navy">{p.title}</a> : p.title}</span>
                    <span class="block text-sm text-faint">{pick(p.meta, lang)}</span>
                  </div>
                  <p class="m-0 text-[15px] leading-relaxed text-body">{pick(p.text, lang)}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="about" class={`${wrap} py-16 border-t border-rule`}>
      <h2 class={h2}>{label('about')}</h2>
      <div class="mt-8">
        <div class="max-w-[56em]">
          <p class="m-0 max-w-[40em] text-lg leading-[1.8] text-body">{pick(bio, lang)}</p>
          <ol class="mt-8 mb-0 list-none p-0 border-l-2 border-navy">
            {timeline.map((x, i) => (
              <li class="relative pl-6 pb-6 last:pb-0">
                <span class:list={['absolute -left-[7px] top-1.5 h-3 w-3 rounded-full', i === 0 ? 'bg-navy' : 'bg-white border-2 border-navy']} aria-hidden="true"></span>
                <p class="m-0 text-sm text-faint">{pick(x.when, lang)}</p>
                <p class="m-0 mt-0.5 text-[17px] font-semibold text-navy">{pick(x.what, lang)}</p>
                <p class="m-0 text-[15px] text-muted">{pick(x.where, lang)}</p>
                {x.note && <p class="m-0 mt-1 max-w-[44em] text-[15px] leading-relaxed text-body">{pick(x.note, lang)}</p>}
              </li>
            ))}
          </ol>
          <dl class="mt-10 mb-0">
            {extras.map((e) => (
              <div class="grid gap-x-8 gap-y-1 border-t border-rule py-3 sm:grid-cols-[140px_1fr]">
                <dt class="text-[15px] font-semibold text-navy">{pick(e.title, lang)}</dt>
                <dd class="m-0">
                  <ul class="m-0 list-disc pl-5 marker:text-faint">
                    {e.items.map((it) => <li class="text-[15px] leading-relaxed text-body">{pick(it, lang)}</li>)}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section id="papers" class={`${wrap} py-16 border-t border-rule`}>
      <h2 class={h2}>{label('papers')}</h2>
      <div class="mt-8 flex flex-col gap-10 max-w-[64em]">
        {paperGroups.map((g) => (
          <div>
            <h3 class="mb-3 mt-0 text-[15px] font-semibold text-muted">{pick(g.title, lang)}</h3>
            <PaperList items={g.items} />
          </div>
        ))}
        <p class="m-0 text-sm text-faint">{pick(ui.coFirst, lang)}</p>
      </div>
    </section>

    <section id="contact" class={`${wrap} pt-16 pb-20 border-t border-rule`}>
      <ContactBlock lang={lang} />
    </section>
  </div>
</Base>
